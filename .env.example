RELAY_ORGANIZER_SESSION_HOURS=8
RELAY_LOGIN_IP_LIMIT=20
RELAY_LOGIN_NAME_LIMIT=5
RELAY_QUEUE_CAPACITY=10
RELAY_PROVIDER_CONCURRENCY=2
RELAY_REMOTE_JOB_SECONDS=600
RELAY_LOCAL_JOB_SECONDS=120
